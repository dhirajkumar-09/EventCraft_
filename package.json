{
  "name": "eventcraft-ai",
  "version": "1.0.0",
  "description": "EventCraft AI - GenAI Celebration & Event Planner",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "postinstall": "cd client && npm install --include=dev",
    "build": "cd client && npm install --include=dev && npx vite build",
    "test": "npm --prefix server test",
    "lint": "npx oxlint client server",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npx oxlint server"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
