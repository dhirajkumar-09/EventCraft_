{
  "name": "eventcraft-ai",
  "version": "1.0.0",
  "description": "EventCraft AI - GenAI Celebration & Event Planner",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
