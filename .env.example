# ==========================================
# EventCraft AI - Environment Configuration
# ==========================================

# Port for the Node/Express backend server (default 5000)
PORT=5000

# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Model used: gemini-2.5-flash with structured JSON responseMimeType
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Node Environment
NODE_ENV=development
